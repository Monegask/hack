{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix prototypes/logistics-race/threejs-trial --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/pvp", "destination": "https://pvp-testnet-testnet.up.railway.app/pvp/", "permanent": false },
    { "source": "/pvp/", "destination": "https://pvp-testnet-testnet.up.railway.app/pvp/", "permanent": false },
    { "source": "/pvp/:path*", "destination": "https://pvp-testnet-testnet.up.railway.app/pvp/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
