# Preparation only. This release cannot sign Mainnet transactions.
# Replace all REQUIRED values with independently verified deployment data.
NEAR_NETWORK=mainnet
ESCROW_API_VERSION=2
# Optional public key for read-only on-chain permission verification; never a private key.
SERVER_RUNTIME_PUBLIC_KEY=
HOST=127.0.0.1
PORT=4191
PUBLIC_ORIGIN=https://REQUIRED.example
NEAR_RPC_URL=https://rpc.mainnet.near.org
TOKEN_ID=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
ESCROW_ID=REQUIRED
SERVER_ACCOUNT=REQUIRED
# Explicit approved 3% fee beneficiary; must match the new contract admin.
FEE_RECEIVER_ID=REQUIRED
ESCROW_CODE_HASH=REQUIRED
DATA_DIR=C:/NEAR-data/supply-line-mainnet
# SERVER_KEY_FILE must remain unset. No env flag can enable Mainnet payments.
MAX_ACTIVE_MATCHES=10
